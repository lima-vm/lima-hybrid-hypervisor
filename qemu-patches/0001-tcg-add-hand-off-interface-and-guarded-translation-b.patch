diff --git a/include/exec/tcg-handoff-code.h b/include/exec/tcg-handoff-code.h
new file mode 100644
index 0000000000..9d2c0f23ae
--- /dev/null
+++ b/include/exec/tcg-handoff-code.h
@@ -0,0 +1,32 @@
+/*
+ * Exact instruction bytes for locally guarded hybrid fallback TBs.
+ * Metadata shares the TB allocation lifetime; ordinary TBs allocate none.
+ * Originally from Virtual Intel Mac:
+ * https://github.com/nfzerox/VirtualIntelMacOnAppleSilicon/blob/0c29f1f0fcaff59fdb6721f7ffa8b4a8c8decb65/Source/vendor/qemu/include/exec/tcg-handoff-code.h
+ * Hybrid Hypervisor was invented by Sam Henri Gold (developer of Light Touch,
+ * https://github.com/samhenrigold). Virtual Intel Mac is by nfzerox.
+ * Copyright (c) 2026 nfzerox
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef EXEC_TCG_HANDOFF_CODE_H
+#define EXEC_TCG_HANDOFF_CODE_H
+
+#include "exec/translation-block.h"
+
+/* x86 fallback TBs cover at most 4096 bytes, including a crossing insn. */
+#define TCG_HANDOFF_CODE_LIMIT 4096
+
+typedef struct TcgHandoffCode {
+    uint16_t length;
+    bool consistent;
+    uint8_t bytes[TCG_HANDOFF_CODE_LIMIT];
+    uint8_t fetched[TCG_HANDOFF_CODE_LIMIT / 8];
+} TcgHandoffCode;
+
+static inline TcgHandoffCode *tcg_handoff_code(TranslationBlock *tb)
+{
+    return (void *)(tb + 1);
+}
+
+#endif
diff --git a/include/exec/translation-block.h b/include/exec/translation-block.h
index 5a7a638b08..ac491cb025 100644
--- a/include/exec/translation-block.h
+++ b/include/exec/translation-block.h
@@ -85,6 +85,7 @@ struct TranslationBlock {
 #define CF_PCREL         0x00020000 /* Opcodes in TB are PC-relative */
 #define CF_BP_PAGE       0x00040000 /* Breakpoint present in code page */
 #define CF_STEP_ATOMIC   0x00080000 /* Running in cpu_exec_step_atomic */
+#define CF_HANDOFF_GUARD 0x00100000 /* Check decoded bytes before hybrid reuse */
 #define CF_CLUSTER_MASK  0xff000000 /* Top 8 bits are cluster ID */
 #define CF_CLUSTER_SHIFT 24
 
