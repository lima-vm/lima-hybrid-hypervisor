+    *reused = false;
     assert_memory_lock();
     qemu_thread_jit_write();
 
@@ -286,7 +288,8 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
 
  buffer_overflow:
     assert_no_pages_locked();
-    tb = tcg_tb_alloc(tcg_ctx);
+    tb = tcg_tb_alloc(tcg_ctx, (s.cflags & CF_HANDOFF_GUARD) ?
+                      sizeof(TcgHandoffCode) : 0);
     if (unlikely(!tb)) {
         /*
          * Flush must be done.  Always exit the cpu loop so that the
@@ -318,6 +321,11 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
     tcg_ctx->guest_mo = cpu->cc->tcg_ops->guest_default_memory_order;
 
  restart_translate:
+    if (s.cflags & CF_HANDOFF_GUARD) {
+        TcgHandoffCode *code = tcg_handoff_code(tb);
+        memset(code, 0, sizeof(*code));
+        code->consistent = true;
+    }
     trace_translate_block(tb, s.pc, tb->tc.ptr);
 
     gen_code_size = setjmp_gen_code(env, tb, s.pc, host_pc, &max_insns, &ti);
@@ -529,10 +537,10 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
 
     /* if the TB already exists, discard what we just translated */
     if (unlikely(existing_tb != tb)) {
-        uintptr_t orig_aligned = (uintptr_t)gen_code_buf;
-
-        orig_aligned -= ROUND_UP(sizeof(*tb), qemu_icache_linesize);
-        qatomic_set(&tcg_ctx->code_gen_ptr, (void *)orig_aligned);
+        /* The guarded-code metadata lies between the TB and gen_code_buf:
+         * roll back to the TB itself to release both. */
+        *reused = true;
+        qatomic_set(&tcg_ctx->code_gen_ptr, (void *)tb);
         tcg_tb_remove(tb);
         return existing_tb;
     }
diff --git a/accel/tcg/translator.c b/accel/tcg/translator.c
index 2083f4285a..7180390a4c 100644
--- a/accel/tcg/translator.c
+++ b/accel/tcg/translator.c
@@ -23,6 +23,51 @@
 #include "internal-common.h"
 #include "disas/disas.h"
 #include "tb-internal.h"
+#include "exec/tcg-handoff-code.h"
+
+static void handoff_record_code(DisasContextBase *db, vaddr pc,
+                                const void *data, size_t length)
+{
+    if (unlikely(db->tb->cflags & CF_HANDOFF_GUARD)) {
+        TcgHandoffCode *code = tcg_handoff_code(db->tb);
+        const uint8_t *bytes = data;
+        uint64_t offset = pc - db->pc_first;
+
+        if (offset > TCG_HANDOFF_CODE_LIMIT ||
+            length > TCG_HANDOFF_CODE_LIMIT - offset) {
+            code->consistent = false;
+            return;
+        }
+        for (size_t i = 0; i < length; i++) {
+            size_t at = offset + i;
+            uint8_t mask = 1u << (at & 7);
+            if ((code->fetched[at / 8] & mask) &&
+                code->bytes[at] != bytes[i]) {
+                code->consistent = false;
+            }
+            code->bytes[at] = bytes[i];
+            code->fetched[at / 8] |= mask;
+        }
+    }
+}
+
+static void handoff_finish_code(TranslationBlock *tb)
+{
+    if (unlikely(tb->cflags & CF_HANDOFF_GUARD)) {
+        TcgHandoffCode *code = tcg_handoff_code(tb);
+        if (tb->size > TCG_HANDOFF_CODE_LIMIT) {
+            code->consistent = false;
+            return;
+        }
+        for (size_t i = 0; i < tb->size; i++) {
+            if (!(code->fetched[i / 8] & (1u << (i & 7)))) {
+                code->consistent = false;
+                break;
+            }
+        }
+        code->length = tb->size;
+    }
+}
 
 #ifndef CONFIG_USER_ONLY
 static void set_can_do_io(DisasContextBase *db, bool val)
@@ -269,6 +314,7 @@ void translator_loop(CPUState *cpu, TranslationBlock *tb, int *max_insns,
     /* May be used by disas_log or plugin callbacks. */
     tb->size = db->pc_next - db->pc_first;
     tb->icount = db->num_insns;
+    handoff_finish_code(tb);
 
     if (plugin_enabled) {
         plugin_gen_tb_end(cpu, db->num_insns);
@@ -526,6 +572,7 @@ uint8_t translator_ldub(CPUArchState *env, DisasContextBase *db, vaddr pc)
         val = cpu_ldb_code_mmu(env, pc, oi, 0);
         record_save(db, pc, &val, sizeof(val));
     }
+    handoff_record_code(db, pc, &val, sizeof(val));
     return val;
 }
 
@@ -539,6 +586,7 @@ uint16_t translator_lduw_end(CPUArchState *env, DisasContextBase *db,
         val = cpu_ldw_code_mmu(env, pc, oi, 0);
         record_save(db, pc, &val, sizeof(val));
     }
+    handoff_record_code(db, pc, &val, sizeof(val));
     if (endian & MO_BSWAP) {
         val = bswap16(val);
     }
@@ -555,6 +603,7 @@ uint32_t translator_ldl_end(CPUArchState *env, DisasContextBase *db,
         val = cpu_ldl_code_mmu(env, pc, oi, 0);
         record_save(db, pc, &val, sizeof(val));
     }
+    handoff_record_code(db, pc, &val, sizeof(val));
     if (endian & MO_BSWAP) {
         val = bswap32(val);
     }
@@ -571,6 +620,7 @@ uint64_t translator_ldq_end(CPUArchState *env, DisasContextBase *db,
         val = cpu_ldq_code_mmu(env, pc, oi, 0);
         record_save(db, pc, &val, sizeof(val));
     }
+    handoff_record_code(db, pc, &val, sizeof(val));
     if (endian & MO_BSWAP) {
         val = bswap64(val);
     }
diff --git a/include/accel/tcg/handoff.h b/include/accel/tcg/handoff.h
new file mode 100644
index 0000000000..616f3fa4bc
--- /dev/null
+++ b/include/accel/tcg/handoff.h
@@ -0,0 +1,43 @@
+/*
+ * Lets another x86 engine take a TCG vCPU's instructions, and give single ones
+ * back. See target/i386/tcg/system/hvdbt.c. NULL unless that is built and asked
+ * for. Guarded fallback quanta also visit the block-selection/completion hooks.
+ *
+ * Originally from Virtual Intel Mac:
+ * https://github.com/nfzerox/VirtualIntelMacOnAppleSilicon/blob/0c29f1f0fcaff59fdb6721f7ffa8b4a8c8decb65/Source/vendor/qemu/include/accel/tcg/handoff.h
+ * Hybrid Hypervisor was invented by Sam Henri Gold (developer of Light Touch,
+ * https://github.com/samhenrigold). Virtual Intel Mac is by nfzerox.
+ * Copyright (c) 2026 nfzerox
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef ACCEL_TCG_HANDOFF_H
+#define ACCEL_TCG_HANDOFF_H
+
+#include "exec/cpu-common.h"
+#include "exec/vaddr.h"
+#include "hw/core/cpu.h"
+
+typedef struct TcgHandoffOps {
+    /* A normal TB is missing for this state: should it run elsewhere instead? */
+    bool (*want_engine)(CPUState *cpu, vaddr pc, uint32_t flags);
+    /* Preserve exact requested steps; otherwise select a guarded TCG block
+     * or request the normal EXCP_HANDOFF path before looking up a TB. */
+    uint32_t (*select_cflags)(CPUState *cpu, vaddr pc, uint32_t flags,
+                              uint32_t cflags, bool exact, bool *handoff);
+    /* A guarded, unchained TB completed (also in serial atomic execution). */
+    void (*completed_tb)(CPUState *cpu, unsigned instructions);
+    /* cpu_exec returned EXCP_HANDOFF. On the vCPU thread with the BQL held. */
+    void (*run)(CPUState *cpu);
+    void (*kick)(CPUState *cpu);
+    /* RAM was written from outside the engine: by TCG's softmmu, or by DMA. */
+    void (*note_write)(uint64_t ram_addr, uint64_t len, bool by_tcg);
+} TcgHandoffOps;
+
+/* Active engine, or NULL. Set by -accel tcg,hybrid=on (accel/tcg/tcg-all.c). */
+extern const TcgHandoffOps *tcg_handoff;
+
+/* An engine built into this QEMU registers its ops at module init. */
+void tcg_handoff_register(const TcgHandoffOps *ops);
+
+#endif
