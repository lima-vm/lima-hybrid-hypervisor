@@ -258,7 +259,7 @@ static int setjmp_gen_code(CPUArchState *env, TranslationBlock *tb,
 }
 
 /* Called with mmap_lock held for user mode emulation.  */
-TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
+TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s, bool *reused)
 {
     CPUArchState *env = cpu_env(cpu);
     TranslationBlock *tb, *existing_tb;
@@ -268,6 +269,7 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
     int64_t ti;
